# ---- Figma (required) ----
FIGMA_TOKEN=figd_xxx
# full URL (node-id recommended) or a bare key: KEY  /  KEY:12-345
FIGMA_URL=https://www.figma.com/design/KEY/Name?node-id=12-345
# FIGMA_FILE_KEY=KEY:12-345
FIGMA_REFRESH=false            # true = ignore .figma_cache and re-fetch (costs an API call)
# FIGMA_RAW=saved_payload.json # offline: build from a saved payload instead of the API

# ---- Output ----
OUTPUT_PATH=out/figma_semantics.json   # default: out/figma_<key>_<node>.json
SAVE_TREE=false                        # also write <output>.tree.json (nested view)
QUIET=false                            # don't print the tree
MAX_DEPTH=12

# ---- Intent labelling ----
INTENT_LABEL=rules             # rules | none | ollama | copilot | deepseek | module:Class
# INTENT_MAP=                  # default: intents.json in the project root (auto-loaded if present)
                               # set a path to use another file, or "none" to disable
INTENT_MODEL=                  # e.g. qwen2.5:7b (ollama), gpt-4.1 (copilot), deepseek-chat
INTENT_MAX_REQUESTS=5          # hard cap on LLM calls per run
INTENT_CHUNK_SIZE=60
INTENT_CONCURRENCY=3
INTENT_LLM_ALL=false           # true = send every node, not just ones rules can't classify

# ---- Backend credentials (only for the one you use) ----
DEEPSEEK_API_KEY=
OLLAMA_URL=http://localhost:11434/v1
COPILOT_MODEL=gpt-4.1